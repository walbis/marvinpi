# ============================================================
#  marvin — otomatik Debian 13 (trixie) kurulumu
#  pi-netboot-setup.sh bu şablondan /opt/llm-repo/preseed.cfg üretir
#  (__PASSWORD_HASH__ yerelde doldurulur, repoya parola girmez).
#
#  DİSK GÜVENLİĞİ — İKİ KATMAN:
#   1) Çekirdek: grub.cfg 'modprobe.blacklist=nvme' geçirir, kurulumcu
#      model diskini hiç görmez. Asıl koruma budur.
#   2) Preseed: hedef disk açıkça /dev/sda'ya sabitlenmiştir.
#  İkisi birbirinden bağımsız; birinde hata olsa diğeri tutar.
# ============================================================

# ---- Yerel ayarlar (mevcut makineyle aynı) ----
d-i debian-installer/locale string tr_TR.UTF-8
d-i keyboard-configuration/xkb-keymap select tr
d-i time/zone string Europe/Istanbul
d-i clock-setup/utc boolean true
d-i clock-setup/ntp boolean true

# ---- Ağ ----
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string marvin
d-i netcfg/get_domain string
d-i netcfg/hostname string marvin
# DHCP'den gelen adı yok say (router 'marvin' dese de kendi adımızı koruruz)
d-i netcfg/dhcp_hostname string

# ---- Depo ----
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/non-free boolean true
d-i apt-setup/contrib boolean true

# ---- Kullanıcı ----
# root girişi kapalı; yönetim marvin + sudo ile.
d-i passwd/root-login boolean false
d-i passwd/user-fullname string marvin
d-i passwd/username string marvin
d-i passwd/user-password-crypted password __PASSWORD_HASH__
d-i user-setup/allow-password-weak boolean false
d-i user-setup/encrypt-home boolean false

# ---- BÖLÜMLEME — YIKICI KISIM ----
# Hedef SADECE /dev/sda. NVMe zaten çekirdek düzeyinde devre dışı.
d-i partman-auto/disk string /dev/sda
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-basicfilesystems/no_swap boolean false
# Onay soruları — otomatik kurulumda sorulmaz
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

# ---- Paketler ----
tasksel tasksel/first multiselect standard, ssh-server
d-i pkgsel/include string openssh-server sudo curl ca-certificates
d-i pkgsel/upgrade select safe-upgrade
popularity-contest popularity-contest/participate boolean false

# ---- Önyükleyici ----
d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string /dev/sda

# ---- Kurulum sonu ----
d-i finish-install/reboot_in_progress note

# ---- late_command ----
# 1) SSH anahtarını Pi'den al: ilk açılışta 'ssh marvin' çalışsın.
# 2) modprobe.blacklist=nvme'yi KURULU SİSTEMDEN temizle — yoksa açılan
#    sistem de model diskini göremez ve /mnt/models boş kalır.
# 3) bootstrap.sh'ı /root'a koy (kurtarma komutu elde hazır olsun).
d-i preseed/late_command string \
    in-target mkdir -p /home/marvin/.ssh; \
    wget -q -O /target/home/marvin/.ssh/authorized_keys http://192.168.1.166:8080/authorized_keys || true; \
    in-target chown -R marvin:marvin /home/marvin/.ssh; \
    in-target chmod 700 /home/marvin/.ssh; \
    in-target chmod 600 /home/marvin/.ssh/authorized_keys; \
    in-target sed -i 's/ *modprobe\.blacklist=nvme//g' /etc/default/grub; \
    in-target update-grub; \
    wget -q -O /target/root/bootstrap.sh http://192.168.1.166:8080/bootstrap.sh || true; \
    in-target chmod 755 /root/bootstrap.sh
